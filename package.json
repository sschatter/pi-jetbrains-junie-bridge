{
  "name": "pi-jetbrains-junie-bridge",
  "version": "1.3.3",
  "description": "Pi extension and OpenCode plugin that connects coding agents with JetBrains Junie",
  "type": "module",
  "pi": {
    "extensions": [
      "./src/entries/pi.ts"
    ]
  },
  "oc-plugin": [
    "server"
  ],
  "exports": {
    ".": "./src/entries/opencode.ts",
    "./server": "./src/entries/opencode.ts"
  },
  "main": "./src/entries/opencode.ts",
  "opencode": "./src/entries/opencode.ts",
  "bin": {
    "junie-openai": "./src/entries/junie-openai.ts"
  },
  "keywords": [
    "pi",
    "pi-package",
    "opencode",
    "junie",
    "jetbrains",
    "coding-agent",
    "ai"
  ],
  "author": "Sven Schatter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sschatter/pi-jetbrains-junie-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/sschatter/pi-jetbrains-junie-bridge/issues"
  },
  "homepage": "https://github.com/sschatter/pi-jetbrains-junie-bridge#readme",
  "engines": {
    "node": ">=22.18.0"
  },
  "files": [
    "src/",
    "docs/",
    "README.md"
  ],
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.23"
  }
}
