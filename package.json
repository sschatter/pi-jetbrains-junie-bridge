{
  "name": "pi-jetbrains-junie-bridge",
  "version": "1.3.3",
  "description": "Pi extension and OpenCode plugin that connects coding agents with JetBrains Junie",
  "type": "module",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "oc-plugin": [
    "server"
  ],
  "exports": {
    ".": "./opencode/index.ts",
    "./server": "./opencode/index.ts"
  },
  "main": "./opencode/index.ts",
  "opencode": "./opencode/index.ts",
  "keywords": [
    "pi",
    "pi-package",
    "opencode",
    "junie",
    "jetbrains",
    "coding-agent",
    "ai"
  ],
  "author": "Sven Schatter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sschatter/pi-jetbrains-junie-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/sschatter/pi-jetbrains-junie-bridge/issues"
  },
  "homepage": "https://github.com/sschatter/pi-jetbrains-junie-bridge#readme",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.ts",
    "opencode/index.ts",
    "lib/",
    "opencode/",
    "docs/",
    "README.md"
  ],
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.23"
  }
}
